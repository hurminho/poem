# Supabase 프로젝트 설정 (Project Settings → API)
# 이 두 값은 클라이언트에 노출되어도 안전합니다.
# URL은 반드시 https://xxxx.supabase.co 형식 (따옴표·한글 주석 없이 한 줄만)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (선택) 서버 전용 service_role 키 — 절대 클라이언트로 노출하지 마세요.
# 비로그인(게스트) 감상평을 직접 insert할 때 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=

# (선택) 사이트 URL — /api/auth/logout, OAuth callback 등에서 사용
# 배포 시에는 https://your-domain.com 으로 설정하세요.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 로컬 데모 계정 (npm run seed:demo 로 생성) ──
# 이메일:   demo@sidam.app
# 비밀번호: SidamDemo2026!
# 운영자까지: npm run seed:demo -- --admin

# ──────────────────────────────────────────────────────────
# 소셜 로그인 (카카오 · 구글 · 애플) 설정 안내
#
# 1) Supabase Dashboard → Authentication → Providers 에서
#    Kakao / Google / Apple 을 각각 활성화하고 Client ID/Secret 을 등록합니다.
#
# 2) Authentication → URL Configuration → Redirect URLs 에
#    아래 두 줄을 추가합니다 (개발/배포 각각):
#      http://localhost:3000/api/auth/callback
#      https://<your-domain>/api/auth/callback
#
# 3) 각 공급자 콘솔(Kakao Developers, Google Cloud, Apple Developer)에는
#    Supabase 가 알려준 콜백 URL
#      https://<project>.supabase.co/auth/v1/callback
#    을 그대로 등록합니다.
#
# Client ID/Secret 자체는 Supabase 가 보관합니다 — 앱 코드 .env 에는 두지 마세요.
# ──────────────────────────────────────────────────────────
